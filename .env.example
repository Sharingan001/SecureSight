# ═══ SecureSight Environment Variables ═══
#
# SECURITY WARNING: Copy this to .env and change ALL secrets before deploying.
# Never commit .env to version control.

# ── App ────────────────────────────────────────────────────
APP_NAME=SecureSight
DEBUG=true
# Set DEBUG=false in production — this also enforces JWT_SECRET validation

# ── Auth ───────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE-ME-use-openssl-rand-hex-32-in-production
JWT_EXPIRE_MINUTES=1440
# Set to false to disable auth (development ONLY)
REQUIRE_AUTH=true

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins. DO NOT use "*" in production.
# CORS_ORIGINS=["https://your-domain.com"]

# ── Database (PostgreSQL) ──────────────────────────────────
# REQUIRED: Change the password!
POSTGRES_USER=securesight
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=securesight
DATABASE_URL=postgresql+asyncpg://securesight:CHANGE-ME-strong-db-password@postgres:5432/securesight

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO / S3 ─────────────────────────────────────────────
# REQUIRED: Change the credentials!
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE-ME-strong-minio-password
MINIO_BUCKET=securesight
MINIO_SECURE=false

# ── Inference ──────────────────────────────────────────────
DEVICE=auto
USE_FP16=true
USE_TTA=true
# EFFICIENTNET_WEIGHTS=/app/weights/efficientnet_b4_deepfake.pth
# XCEPTION_WEIGHTS=/app/weights/xception_deepfake.pth

# ── Upload Limits ──────────────────────────────────────────
MAX_UPLOAD_MB=500
VIDEO_SAMPLE_FPS=2.0
MAX_VIDEO_FRAMES=120
